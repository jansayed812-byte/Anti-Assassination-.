{
  "name": "ops-security-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "setup": "npm install && npm install --prefix services && npm install --prefix dashboard",
    "build": "npm --prefix dashboard run build && npm --prefix services run typecheck",
    "start": "npm --prefix services start",
    "dev": "node scripts/dev.mjs",
    "typecheck": "npm --prefix services run typecheck && npm --prefix dashboard run typecheck",
    "lint": "eslint 'services/**/*.ts' 'tests/**/*.ts' --ext .ts",
    "fetch:osm": "node scripts/fetch-osm.mjs",
    "test:e2e": "playwright test",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.0",
    "@types/pg": "^8.10.0",
    "autocannon": "^7.15.0",
    "better-sqlite3": "^9.2.2",
    "h3-js": "^4.5.0",
    "socket.io-client": "^4.8.4",
    "typescript": "^5.1.6",
    "vitest": "^1.0.0"
  }
}
