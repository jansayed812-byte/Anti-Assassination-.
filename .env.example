# Environment Variables - سیستم ارزیابی امنیتی (Security Assessment)

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_USER=ops_user
DB_PASSWORD=ops_secure_password
DB_NAME=ops_database

# TimescaleDB Configuration
TIMESCALE_HOST=timescaledb
TIMESCALE_PORT=5432
TIMESCALE_USER=ts_user
TIMESCALE_PASSWORD=ts_secure_password
TIMESCALE_DB=ts_database

# NATS Configuration
NATS_URL=nats://ops_admin:ops_admin_password@nats:4222
NATS_ADMIN_USER=ops_admin
NATS_ADMIN_PASSWORD=ops_admin_password
NATS_SERVICE_USER=ops_service
NATS_SERVICE_PASSWORD=ops_service_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password
REDIS_DB=0

# MinIO Configuration
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_USER=ops_admin
MINIO_PASSWORD=ops_minio_password
MINIO_BUCKET_NAME=ops-media

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Operations console backend (services/server)
PORT=8000
HOST=0.0.0.0
# comma-separated browser origins allowed by CORS in dev (the built console is served same-origin)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# initial password for every demo account (ahmadi, maryam, reza, ali, sara, admin)
DEMO_PASSWORD=demo
# true enables POST /api/auth/switch-role (role switching from the account menu); default: on unless NODE_ENV=production
DEMO_MODE=true
# defaults to ../dashboard/dist relative to services/server
STATIC_DIR=

# Security
JWT_SECRET=your_jwt_secret_key_here_minimum_32_chars
JWT_EXPIRY=24h
SESSION_SECRET=your_session_secret_here

# Encryption
ENCRYPTION_KEY=your_encryption_key_minimum_32_chars
ENCRYPTION_ALGORITHM=aes-256-gcm

# GNSS/GPS Configuration
GNSS_ENABLED=true
GNSS_TIMEOUT_MS=5000
GNSS_ACCURACY_THRESHOLD_M=100

# Fusion Configuration
FUSION_ENABLED=true
FUSION_UPDATE_RATE_HZ=10
FUSION_COVARIANCE_INITIAL=100.0

# Risk Assessment
RISK_CALCULATION_ENABLED=true
RISK_UPDATE_INTERVAL_S=60

# Video Analysis (Phase 8)
VIDEO_ENABLED=false
VIDEO_INFERENCE_ENABLED=false
VIDEO_BITRATE_KBPS=5000
VIDEO_FRAMERATE_FPS=30

# Scenario Simulation (Phase 6)
SIMULATION_ENABLED=false
SIMULATION_DATA_DIR=/scenarios

# Compliance Frameworks
COMPLIANCE_ISO27001_ENABLED=true
COMPLIANCE_CIS_ENABLED=true
COMPLIANCE_SOC2_ENABLED=false

# Monitoring and Logging
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
GRAFANA_PORT=3001

# Health Check
HEALTH_CHECK_INTERVAL_S=30
HEALTH_CHECK_TIMEOUT_S=5

# Audit Logging
AUDIT_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# External Integrations
SLACK_WEBHOOK_URL=
JIRA_ENABLED=false
JIRA_HOST=
JIRA_USER=
JIRA_API_TOKEN=

# Geographic Data
MAP_PROVIDER=osm
MAP_TILE_SERVER=https://tile.openstreetmap.org
OFFLINE_MAPS_ENABLED=false
OFFLINE_MAPS_DIR=/map-data

# Development/Debug
DEBUG=false
MOCK_DATA_ENABLED=false
SEED_DATABASE=false

# Operations console (npm start / make console)
JWT_SECRET=change-me-to-a-long-random-secret
DEMO_PASSWORD=demo
DEMO_MODE=true
# Map: vector style and terrain DEM. Point these at self-hosted tiles for fully offline deployments.
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_TERRAIN_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png
MAP_TERRAIN_ENCODING=terrarium
# Branches to run (MZR = Mazar-i-Sharif HQ, KBL = Kabul, HRT = Herat) and optional OSM extract directory
BRANCHES=MZR,KBL,HRT
# OSM_DIR=services/data/osm
RATE_LIMIT_RPM=1200
